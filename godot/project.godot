; Engine configuration file.
config_version=5

[application]
config/name="HD2D Fable - Godot"
run/main_scene="res://main.tscn"
run/max_fps=120
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
camera/depth_of_field/depth_of_field_bokeh_quality=3
camera/depth_of_field/depth_of_field_bokeh_shape=2
camera/depth_of_field/depth_of_field_use_jitter=false
environment/volumetric_fog/volume_size=192
environment/volumetric_fog/volume_depth=192
environment/volumetric_fog/use_filter=1
environment/screen_space_reflection/half_size=false
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=4096
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.05, 0.04, 0.07, 1)
